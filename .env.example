# Copy this file to .env.local and fill in the values from:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL)
#
# Both values are safe to expose to the browser: the publishable key only
# allows what Row Level Security permits. NEVER add the secret/service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Optional: live database tests (npm run test:db) ---
# Put these in .env.test.local (not here). Use a DEVELOPMENT project.
# TEST_SUPABASE_URL=https://your-dev-project-ref.supabase.co
# TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# TEST_USER_EMAIL=you@example.com
# TEST_USER_PASSWORD=your-dev-user-password
